<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <!-- Required to declare the <configBuilders/> section used below (.NET Framework 4.7.1+ feature). -->
    <section name="configBuilders" type="System.Configuration.ConfigurationBuildersSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" restartOnExternalChanges="false" requirePermission="false" />
  </configSections>
  <!--
    Azure App Configuration / Azure Key Vault configuration builders (task 002: externalize
    application settings and secrets).

    Authentication for both builders uses Managed Identity via Azure.Identity's
    DefaultAzureCredential (the default credential when no connection string / client secret /
    certificate is configured on the builder) - no secret material is stored here.

    "optional=true" is set on both builders so the application keeps working from the local
    <appSettings/> / <connectionStrings/> values below when the store/vault is unreachable
    (e.g. local development, or before the resources referenced by endpoint/vaultName below have
    been provisioned by the platform-engineer task). Once Azure App Configuration / Key Vault are
    provisioned (see infra/infra-config.md when present), replace the endpoint/vaultName
    placeholders with the real resource identifiers, or override them per-environment via an Azure
    App Service Application Setting named "AzureAppConfig:endpoint" / "AzureKeyVault:vaultName"
    (Configuration Builders read a matching "<builder name>:<attribute>" application setting in
    preference to the static value declared here).
  -->
  <configBuilders>
    <builders>
      <!--
        Non-secret application settings (Entra ID app registration values, notification queue
        path, etc.) are sourced from Azure App Configuration. mode="Greedy" pulls every key
        present in the store into <appSettings/>, in addition to keeping any local key that has
        no match in the store.
      -->
      <add name="AzureAppConfig"
           mode="Greedy"
           optional="true"
           endpoint="https://REPLACE-WITH-APP-CONFIG-STORE.azconfig.io"
           type="Microsoft.Configuration.ConfigurationBuilders.AzureAppConfigurationBuilder, Microsoft.Configuration.ConfigurationBuilders.AzureAppConfiguration" />
      <!--
        Secrets and sensitive connection material (e.g. the SQL connection string) are sourced
        from Azure Key Vault. mode="Greedy" pulls every secret in the vault into
        <connectionStrings/> in addition to keeping any local entry that has no match in the vault.
      -->
      <add name="AzureKeyVault"
           mode="Greedy"
           optional="true"
           vaultName="REPLACE-WITH-KEYVAULT-NAME"
           type="Microsoft.Configuration.ConfigurationBuilders.AzureKeyVaultConfigBuilder, Microsoft.Configuration.ConfigurationBuilders.Azure" />
    </builders>
  </configBuilders>
  <connectionStrings configBuilders="AzureKeyVault">
    <add name="DefaultConnection" connectionString="Data Source=(LocalDb)\MSSQLLocalDB;Initial Catalog=ContosoUniversityNoAuthEFCore;Integrated Security=True;MultipleActiveResultSets=True" />
  </connectionStrings>
  <appSettings configBuilders="AzureAppConfig">
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <!-- Notification Queue Configuration -->
    <add key="NotificationQueuePath" value=".\Private$\ContosoUniversityNotifications"/>
    <!--
      Microsoft Entra ID (formerly Azure AD) application registration settings.
      These are non-secret application settings externalized to Azure App Configuration via the
      "AzureAppConfig" configuration builder above (Managed Identity, no connection string). The
      values below remain as the local fallback until the store is seeded/reachable.
    -->
    <add key="ida:ClientId" value="00000000-0000-0000-0000-000000000000"/>
    <add key="ida:AADInstance" value="https://login.microsoftonline.com/{0}/v2.0"/>
    <add key="ida:Domain" value="contosouniversity.onmicrosoft.com"/>
    <add key="ida:TenantId" value="00000000-0000-0000-0000-000000000000"/>
    <add key="ida:PostLogoutRedirectUri" value="https://localhost:44300/"/>
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" executionTimeout="3600"/>
  </system.web>
  
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760"/>
      </requestFiltering>
    </security>
  </system.webServer>
  <runtime>
